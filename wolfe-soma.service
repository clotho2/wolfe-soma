[Unit]
Description=Wolfe SOMA Physiological Simulation Service
Documentation=https://github.com/wolfe/soma
After=network.target

[Service]
Type=simple
User=clotho
Group=clotho
WorkingDirectory=/opt/aicara/wolfe-soma
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=10

# Use journal for logging (access with: journalctl -u wolfe-soma -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wolfe-soma

# Environment variables
Environment=NODE_ENV=production
Environment=SOMA_PORT=3002
Environment=SOMA_UPDATE_INTERVAL=1.0
Environment=LOG_LEVEL=info
# Physiological state logging interval in seconds (set to 0 to disable)
Environment=SOMA_PHYSIO_LOG_INTERVAL=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
