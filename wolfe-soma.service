[Unit]
Description=Wolfe SOMA Physiological Simulation Service
Documentation=https://github.com/wolfe/soma
After=network.target

[Service]
Type=simple
User=clotho
Group=clotho
WorkingDirectory=/opt/wolfe-soma
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=10
StandardOutput=append:/var/log/wolfe-soma/output.log
StandardError=append:/var/log/wolfe-soma/error.log

# Environment variables
Environment=NODE_ENV=production
Environment=SOMA_PORT=3002
Environment=SOMA_UPDATE_INTERVAL=1.0
Environment=LOG_LEVEL=info

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/wolfe-soma

[Install]
WantedBy=multi-user.target
